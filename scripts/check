#!/usr/bin/env bash
# Runs the checks that CI runs. It never changes files.
#
# Usage: scripts/check [fmt|layout|check|deny|licenses]
#
# With no argument it runs all five. CI runs each job on its own and installs the tools at the
# versions pinned here.
set -euo pipefail

cargo_deny_version=0.22.0
cargo_about_version=0.9.3

cd "$(dirname "$0")/.."
export CARGO_BUILD_WARNINGS=deny

require_tool() {
  local tool=$1 subcommand=$2 version=$3 install=$4
  local found
  found=$(cargo "$subcommand" --version 2>/dev/null || true)
  if [[ $found != "$tool $version" ]]; then
    echo "scripts/check: needs $tool $version, found: ${found:-none}" >&2
    echo "Install it with: $install" >&2
    exit 1
  fi
}

check_fmt() {
  cargo fmt --all --check
}

# The one integration test binary of a crate. A second one needs the user's approval.
test_targets=(integration)

# The bans of the test layout. The places it names are in the Tests section of .claude/CLAUDE.md.
check_layout() {
  local files found failed=0
  files=$(git ls-files --cached --others --exclude-standard -- crates | while read -r path; do
    [[ -e $path ]] && echo "$path"
  done)

  layout_error() {
    echo "scripts/check layout: $1" >&2
    sed 's/^/  /' <<<"$2" >&2
    failed=1
  }

  found=$(grep '\.rs$' <<<"$files" | xargs grep -nE '^\s*(pub(\([a-z]+\))? )?mod tests\s*\{' || true)
  [[ -z $found ]] || layout_error \
    'inline `mod tests { … }`: put the tests in the child file foo/tests.rs, declared `#[cfg(test)] mod tests;`' \
    "$found"

  found=$(grep '\.rs$' <<<"$files" | xargs awk '
    /^[[:space:]]*#\[path/ { has_path = 1; next }
    /^[[:space:]]*#\[cfg\(test\)\]/ { is_test = 1; next }
    /^[[:space:]]*#\[/ { next }
    {
      if (has_path && (is_test || $0 ~ /mod [a-z_]*(test|speed)/)) print FILENAME ":" FNR ": " $0
      has_path = 0; is_test = 0
    }' || true)
  [[ -z $found ]] || layout_error \
    '`#[path]` on a test module: name the file foo/tests.rs or foo/tests/<topic>.rs, so `mod` finds it' \
    "$found"

  local targets
  targets=$(IFS='|'; echo "${test_targets[*]}")
  found=$({
    grep -E '^crates/[^/]+/tests/[^/]+\.rs$' <<<"$files" || true
    grep -E '^crates/[^/]+/tests/[^/]+/main\.rs$' <<<"$files" | grep -vE "/tests/($targets)/main\.rs$" || true
    grep 'Cargo\.toml$' <<<"$files" | xargs grep -nF '[[test]]' || true
  })
  [[ -z $found ]] || layout_error \
    "a test target outside tests/integration/: make it the module tests/integration/<topic>.rs" \
    "$found"

  found=$(grep 'Cargo\.toml$' <<<"$files" | xargs grep -nE '^name = ".*-test"' || true)
  [[ -z $found ]] || layout_error \
    'a test-only crate: put its helpers in the `testing` module of the crate they test, behind `test-support`' \
    "$found"

  found=$(grep -E '^crates/[^/]+/tests/' <<<"$files" |
    grep -vE '\.rs$|/snapshots/[^/]+\.snap$|^crates/[^/]+/tests/proptest-regressions/[^/]+\.txt$' || true)
  [[ -z $found ]] || layout_error \
    "data under tests/: put it in test_data/<kind>/ at the crate root" \
    "$found"

  return "$failed"
}

check_check() {
  cargo clippy --locked --workspace --all-targets --all-features
  cargo test --locked --workspace
  RUSTDOCFLAGS="-D warnings" cargo doc --locked --workspace --no-deps --document-private-items
}

check_deny() {
  require_tool cargo-deny deny "$cargo_deny_version" \
    "cargo install --locked cargo-deny@$cargo_deny_version"
  cargo deny --locked check bans sources
}

check_licenses() {
  require_tool cargo-about about "$cargo_about_version" \
    "cargo install --locked --features cli cargo-about@$cargo_about_version"
  cargo about generate --locked --fail packaging/notices/crates.hbs >/dev/null
}

case "${1:-all}" in
  fmt | layout | check | deny | licenses) "check_$1" ;;
  all)
    check_fmt
    check_layout
    check_check
    check_deny
    check_licenses
    ;;
  *)
    echo "usage: scripts/check [fmt|layout|check|deny|licenses]" >&2
    exit 2
    ;;
esac
